# Copy to .env and fill. Never commit .env. Names only here (SECURITY.md §3).
DATABASE_URL=postgresql+psycopg://hr:hr@localhost:5433/hr
DATABASE_URL_RO=postgresql+psycopg://hr_ro:hr_ro@localhost:5433/hr
SESSION_SECRET=
# LLM: any OpenAI-compatible endpoint.
#  local (free, nothing leaves): Ollama → http://localhost:11434/v1, key "ollama", model "qwen2.5:7b"
#  production (free tier): Groq → https://api.groq.com/openai/v1, key = your Groq key, model "llama-3.3-70b-versatile"
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=BAAI/bge-small-en-v1.5
COOKIE_SECURE=false  # true in the deployed demo (HTTPS); false for local http
